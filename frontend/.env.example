# Origin of the FastAPI backend, used server-side by the /api/:path*
# rewrite in next.config.mjs. No NEXT_PUBLIC_ prefix needed.
# Local dev default when unset: http://127.0.0.1:8000
# Production (Vercel):        https://cyberverse-api.onrender.com
BACKEND_URL=

# Optional: GA4 measurement ID. The analytics layer is a silent no-op until
# this is set, and only fires after the visitor accepts cookie consent.
NEXT_PUBLIC_GA_ID=
