# Configure these ONLY in the backend hosting provider's secret/environment settings.
# Create an R2 API token scoped to the cyberverse-assets bucket with Object Read & Write.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cyberverse-assets
# Optional; if omitted, endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
SIGNED_URL_EXPIRE_SECONDS=300
