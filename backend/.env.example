# ===== CyberVerse Environment Configuration =====
# Copy to .env and fill in values. NEVER commit the real .env.

# Application
APP_NAME=CyberVerse API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-64-char-random-secret
API_V1_PREFIX=/api/v1

# Database (Supabase PostgreSQL in production)
DATABASE_URL=postgresql://cyberverse:cyberverse@localhost:5432/cyberverse

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-me-to-another-64-char-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase (optional — auth/storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@cyberverse.io
SENDGRID_FROM_NAME=CyberVerse

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# OpenRouter (AI Mentor chat — recommended: https://openrouter.ai/keys)
# OPENROUTER_API_KEY takes priority over OPENAI_API_KEY for the mentor chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=1000
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=CyberVerse
AI_CHAT_RATE_LIMIT_PER_MINUTE=10

# Monitoring
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json