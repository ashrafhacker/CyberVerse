# ===== CyberVerse Environment Configuration =====
# Copy to .env and fill in values. NEVER commit the real .env.

# Application
APP_NAME=CyberVerse API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-64-char-random-secret
API_V1_PREFIX=/api/v1

# Database (Supabase PostgreSQL in production)
DATABASE_URL=postgresql://cyberverse:cyberverse@localhost:5432/cyberverse

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=change-me-to-another-64-char-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase (optional — auth/storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@cyberverse.io
SENDGRID_FROM_NAME=CyberVerse

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Monitoring
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json